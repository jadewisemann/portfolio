# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 폰트 원본 (합계 약 40MB, OFL-1.1). npm run fonts:fetch 로 다시 받는다.
# 라이선스 고지는 src/fonts/licenses/ 에 커밋된다 (OFL-1.1 요구).
/src/fonts/_src/

# Playwright 산출물
/test-results/
/playwright-report/

# 에이전트 워크트리 (내용은 worktree-agent-* 브랜치로 보존)
/.claude/worktrees/
