{
  "version": 2,
  "start": "BOOTSTRAP",
  "terminal": "COMPLETE",
  "nodes": {
    "BOOTSTRAP": {
      "title": "하네스 무결성 점검",
      "owner": "main",
      "verify": "doctor",
      "edges": {
        "pass": "REPOSITORY_AUDIT"
      }
    },
    "REPOSITORY_AUDIT": {
      "title": "저장소 감사",
      "owner": "main",
      "produces": [
        {
          "path": "docs/portfolio/DECISIONS.md",
          "mustMatch": "## Repository audit"
        }
      ],
      "edges": {
        "pass": "CONTENT_INVENTORY"
      }
    },
    "CONTENT_INVENTORY": {
      "title": "검증된 포트폴리오 사실 수집",
      "owner": "main",
      "produces": [
        {
          "path": "docs/portfolio/BRIEF.md",
          "mustNotMatch": "Status: not supplied"
        },
        {
          "path": "docs/portfolio/CONTENT.md",
          "mustNotMatch": "Status: not supplied"
        }
      ],
      "edges": {
        "pass": "COMPONENT_RESEARCH"
      }
    },
    "COMPONENT_RESEARCH": {
      "title": "컴포넌트·패턴 리서치",
      "agents": [
        "component-scout"
      ],
      "skill": "component-research",
      "parallel": true,
      "produces": [
        {
          "path": "docs/portfolio/COMPONENT_REGISTRY.md",
          "mustMatch": "https?://"
        }
      ],
      "edges": {
        "pass": "ART_DIRECTION_BRANCH"
      }
    },
    "ART_DIRECTION_BRANCH": {
      "title": "경쟁 아트 디렉션 생성",
      "agents": [
        "art-director"
      ],
      "skill": "art-direction",
      "parallel": true,
      "evidence": [
        {
          "dir": "docs/portfolio/directions",
          "minFiles": 3,
          "pattern": "\\.md$",
          "why": "산문 스펙은 여기까지만 유효하다. 확정은 DIRECTION_RENDER 의 픽셀로 한다"
        }
      ],
      "edges": {
        "pass": "DIRECTION_RENDER"
      }
    },
    "DIRECTION_RENDER": {
      "title": "방향 후보를 실제로 렌더",
      "agents": [
        "frontend-builder"
      ],
      "evidence": [
        {
          "dir": "review/directions",
          "minFiles": 9,
          "pattern": "\\.png$",
          "why": "3개 방향 x 3개 뷰포트. 렌더 안 된 방향은 심사 대상이 아니다"
        },
        {
          "dir": "review/directions",
          "minFiles": 3,
          "pattern": "320.*\\.png$",
          "why": "모바일을 강제한다. 데스크톱만 렌더하면 모바일이 3안에서 동일해진다 (2026-08-31 런의 실제 결함)"
        }
      ],
      "edges": {
        "pass": "DIRECTION_JUDGE"
      }
    },
    "DIRECTION_JUDGE": {
      "title": "디렉션 심사·확정 (렌더된 화면으로만)",
      "owner": "main",
      "evidence": [
        {
          "dir": "review/directions",
          "minFiles": 9,
          "pattern": "\\.png$",
          "why": "판정 근거가 화면에 실제로 존재해야 한다. 스펙을 읽고 고르는 것은 금지"
        }
      ],
      "produces": [
        {
          "path": "docs/portfolio/ART_DIRECTION.md",
          "mustNotMatch": "Status: not selected"
        },
        {
          "path": "docs/portfolio/DECISIONS.md",
          "mustMatch": "## Direction lock"
        },
        {
          "path": "docs/portfolio/DECISIONS.md",
          "mustMatch": "review/directions/"
        }
      ],
      "edges": {
        "pass": "DESIGN_SYSTEM"
      }
    },
    "DESIGN_SYSTEM": {
      "title": "디자인 시스템 정의",
      "agents": [
        "art-director"
      ],
      "produces": [
        {
          "path": "docs/portfolio/DESIGN_SYSTEM.md",
          "mustNotMatch": "Status: not defined"
        }
      ],
      "edges": {
        "pass": "MOTION_SYSTEM"
      }
    },
    "MOTION_SYSTEM": {
      "title": "모션 언어 정의",
      "agents": [
        "motion-architect"
      ],
      "skill": "motion-system",
      "produces": [
        {
          "path": "docs/portfolio/MOTION_LANGUAGE.md",
          "mustNotMatch": "Status: not defined"
        }
      ],
      "edges": {
        "pass": "SCENE_GRAPH"
      }
    },
    "SCENE_GRAPH": {
      "title": "씬 그래프 정의",
      "owner": "main",
      "skill": "scene-graph",
      "produces": [
        {
          "path": "docs/portfolio/SCENE_GRAPH.md",
          "mustNotMatch": "Status: not defined"
        }
      ],
      "edges": {
        "pass": "GOLDEN_SLICE"
      }
    },
    "GOLDEN_SLICE": {
      "title": "골든 슬라이스 구현",
      "agents": [
        "frontend-builder"
      ],
      "skill": "golden-slice",
      "edges": {
        "pass": "GOLDEN_REVIEW"
      }
    },
    "GOLDEN_REVIEW": {
      "title": "골든 슬라이스 게이트",
      "agents": [
        "visual-critic",
        "motion-critic",
        "performance-auditor",
        "accessibility-auditor"
      ],
      "parallel": true,
      "evidence": {
        "dir": "review/golden-slice",
        "minFiles": 8,
        "pattern": "\\.(png|jpg|md)$"
      },
      "gate": {
        "scorecard": "docs/portfolio/scorecard.json",
        "thresholds": {
          "visualImpact": 9,
          "artDirection": 9,
          "motionCoherence": 9,
          "typography": 9,
          "composition": 9,
          "originality": 8.5,
          "narrativeClarity": 8.5,
          "interactionQuality": 8.5,
          "mobile": 8.5,
          "performance": 8,
          "accessibility": 8
        }
      },
      "edges": {
        "pass": "EXPAND_SCENES",
        "fail": "GOLDEN_FIX"
      }
    },
    "GOLDEN_FIX": {
      "title": "실패 카테고리 패치",
      "agents": [
        "frontend-builder"
      ],
      "maxIterations": 3,
      "edges": {
        "pass": "GOLDEN_REVIEW",
        "exhausted": "STRUCTURAL_BRANCH"
      }
    },
    "STRUCTURAL_BRANCH": {
      "title": "슬라이스 구조 재설계",
      "agents": [
        "art-director",
        "motion-architect"
      ],
      "resetIteration": true,
      "evidence": [
        {
          "dir": "review/structural",
          "minFiles": 9,
          "pattern": "\\.png$",
          "why": "구조 재설계도 산문으로 확정하지 않는다. 3개 후보 x 3개 뷰포트가 실제로 렌더돼 있어야 한다 — ART_DIRECTION_BRANCH 가 .md 3장으로 통과해 시각 충격 2.8 을 낳은 것과 같은 실패를 막는다"
        },
        {
          "dir": "review/structural",
          "minFiles": 3,
          "pattern": "320.*\\.png$",
          "why": "모바일을 강제한다. 직전 Best-of-N 의 3안은 320px 에서 바이트 동일했다"
        }
      ],
      "produces": [
        {
          "path": "docs/portfolio/DECISIONS.md",
          "mustMatch": "## Structural branch"
        },
        {
          "path": "docs/portfolio/DECISIONS.md",
          "mustMatch": "review/structural/"
        }
      ],
      "edges": {
        "pass": "GOLDEN_SLICE"
      }
    },
    "EXPAND_SCENES": {
      "title": "잔여 씬 구현",
      "agents": [
        "frontend-builder"
      ],
      "edges": {
        "pass": "WHOLE_EXPERIENCE_AUDIT"
      }
    },
    "WHOLE_EXPERIENCE_AUDIT": {
      "title": "전체 경험 시각·모션 감사",
      "agents": [
        "visual-critic",
        "motion-critic"
      ],
      "parallel": true,
      "evidence": {
        "dir": "review/scenes",
        "minFiles": 2,
        "pattern": "\\.(png|jpg|md)$"
      },
      "edges": {
        "pass": "MOBILE_AUDIT"
      }
    },
    "MOBILE_AUDIT": {
      "title": "모바일 경험 감사",
      "agents": [
        "visual-critic"
      ],
      "edges": {
        "pass": "PERFORMANCE_AUDIT"
      }
    },
    "PERFORMANCE_AUDIT": {
      "title": "성능 감사",
      "agents": [
        "performance-auditor"
      ],
      "skill": "performance-review",
      "edges": {
        "pass": "ACCESSIBILITY_AUDIT"
      }
    },
    "ACCESSIBILITY_AUDIT": {
      "title": "접근성 감사",
      "agents": [
        "accessibility-auditor"
      ],
      "skill": "accessibility-review",
      "edges": {
        "pass": "REGRESSION"
      }
    },
    "REGRESSION": {
      "title": "최종 검증 게이트",
      "owner": "main",
      "skill": "final-experience-audit",
      "verify": "gate",
      "edges": {
        "pass": "COMPLETE"
      }
    },
    "COMPLETE": {
      "title": "워크플로 완료",
      "terminal": true,
      "requires": [
        {
          "path": "docs/portfolio/FINAL_AUDIT.md",
          "mustNotMatch": "Status: pending"
        }
      ]
    }
  }
}
